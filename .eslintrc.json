{
  "env": {
    "node": true,
    "es2021": true
  },
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "error",
    "eqeqeq": "warn",
    "semi": ["warn", "always"],
    "quotes": ["warn", "single"]
  }
}
